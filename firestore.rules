rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'saracbwendling@gmail.com';
    }

    match /siteSettings/public {
      allow read: if true;

      allow create, update: if isAdmin()
        && request.resource.data.courseName is string
        && request.resource.data.courseDescription is string
        && request.resource.data.price is number
        && request.resource.data.oldPrice is number
        && request.resource.data.checkoutUrl is string
        && request.resource.data.contactEmail is string;

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
